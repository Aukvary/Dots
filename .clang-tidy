Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  cert-*,
  concurrency-*,
  modernize-*,
  performance-*,
  portability-*,
  -google-*,
  -readability-readability-google-*,
  -readability-implicit-bool-conversion,
  -bugprone-easily-swappable-parameters,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-identifier-naming,
  -readability-magic-numbers,
  -readability-comment-internal-link,
  -llvm-header-guard,
  -llvm-include-order
WarningsAsErrors: ''
HeaderFilterRegex: '.*'
FormatStyle: file
