{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",        // Logo type: auto, builtin, small, file, etc.
    "source": "~/.config/fastfetch/logo.txt",      // Built-in logo name or file path
    "width": 5,           // Width in characters
    "height": 5,          // Height in characters
    "padding": {
        "top": 0,          // Top padding
        "left": 0,         // Left padding
        "right": 0         // Right padding
    },
    "color": {             // Override logo colors
        "1": "magenta",
        "2": "magenta"
    }

  },

  "display": {
    "separator": ": "
},

  
  "modules": [
    {
        "type": "custom",
        "format": "\u001b[35m┌──────────────────────Hardware──────────────────────┐"
        
    },
    {
        "type": "host",
        "key" : "󰌢 PC ",
        "format" : "{name}",
        "keyColor" : "magenta"
    },
    {
        "type"  : "cpu",
        "key"   : "│ ├ ",
        "format": "{name}",
        "keyColor" : "magenta"
    },
    {
        "type"   : "gpu",
        "key"    : "│ ├󰾲 ",
        "format" : "{name}",
        "keyColor" : "magenta"
    },
    {
        "type"  : "memory",
        "key"   : "│ ├ ",
        "format": "{used} / {total}",
        "keyColor": "magenta"
    },
    {
        "type"  : "disk",
        "key"   : "│ ├ ",
        "format": "{size-used} / {size-total}",
        "keyColor": "magenta"
    },

    {
        "type" : "custom",
        "format": "\u001b[35m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
        "type": "custom",
        "format": "\u001b[35m┌──────────────────────Software──────────────────────┐"
    },
    {
        "type": "os",
        "key" : " OS ",
        "format": "{name}",
        "keyColor": "magenta"
    },
    {
        "type": "shell",
        "key" : "│ ├ ",
        "format" : "{process-name}",
        "keyColor": "magenta"
    },
    {
        "type": "kernel",
        "key" : "│ ├ ",
        "format": "{sysname} {release}",
        "keyColor": "magenta"
    },
    {
        "type": "wm",
        "key": "│ ├ ",
        "format": "{process-name} ({protocol-name})",
        "keyColor": "magenta"
    },
    {
        "type": "packages",
        "key" : "│ ├󰏖 ",
        "format" : "Pacman: {pacman} | Flatpack: {flatpak-all}",
        "keyColor": "magenta"
    },
    {
        "type" : "custom",
        "format": "\u001b[35m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
        "type": "custom",
        "format": "\u001b[35m┌──────────────────────Age/Uptime────────────────────┐"
    },
    {
        "type": "command",
        "key": "│ > OS Age ",
        "keyColor": "magenta",
        "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
        "type": "uptime",
        "key": "│ >  ",
        "keyColor": "magenta"
    },
    {
        "type" : "custom",
        "format": "\u001b[35m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
        "type": "colors",
        "paddingLeft": 2,
        "symbol": "circle"
    }
  ]
}
