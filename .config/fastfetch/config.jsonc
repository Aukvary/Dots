{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/sad_emote.txt",
        "height": 15,
        "padding": { "bottom": 1 },
        "color": {
            "1": "#f2d5cf",
            "2": "#eebebe",
            "3": "#f4b8e4",
            "4": "#ca9ee6",
            "5": "#e78284",
            "6": "#ea999c",
            "7": "#ef9f76",
            "8": "#e5c890",
            "9": "#a6d189"
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "#8af5ff",
            "title": "#f2d5cf"
        }
    },
    "modules": [
        { "key": "╭───────────╮", "keyColor": "#838ba7", "type": "custom" },
        { "key": "│  user    │", "keyColor": "#81c8be", "type": "title", "format": "{user-name}" },
        { "key": "│ 󰇅 hname   │", "keyColor": "#81c8be", "type": "title", "format": "{host-name}" },
        { "key": "│  distro  │", "keyColor": "#85c1dc", "type": "os" },
        { "key": "│  kernel  │", "keyColor": "#99d1db", "type": "kernel" },
        { "key": "│  wm      │", "keyColor": "#ca9ee6", "type": "wm" },
        { "key": "│  shell   │", "keyColor": "#f4b8e4", "type": "shell" },
        { "key": "│ 󰍛 cpu     │", "keyColor": "#a6d189", "type": "cpu", "showPeCoreCount": true },
        { "key": "│ 󰢮 gpu     │", "keyColor": "#e5c890", "type": "gpu", "format": "{1} {2} @ {12}" },
        { "key": "│  memory  │", "keyColor": "#ef9f76", "type": "memory" },
        { "key": "│ 󰉉 disk    │", "keyColor": "#ea999c", "type": "disk", "folders": "/" },
        { "key": "╰───────────╯", "keyColor": "#838ba7", "type": "custom" }
    ]
}
